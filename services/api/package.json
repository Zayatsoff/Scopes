{
  "name": "api",
  "version": "1.0.0",
  "main": "index.js",
  "private": true,
  "scripts": {
    "compile": "tsc --noEmit",
    "test": "jest",
    "scrape:news": "ts-node -r dotenv/config scripts/scrape-news.ts dotenv_config_path=.env.local",
